+    } else {
+      showToast(res.message || '取消提交失败')
+    }
+  } catch (error) {
+    console.error('Failed to cancel submission:', error)
+    showToast(error?.response?.data?.message || '取消提交失败')
+  } finally {
+    cancelingSubmissionId.value = ''
+  }
+}
